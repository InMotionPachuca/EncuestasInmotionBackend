services:
  - type: web
    name: encuestas-backend
    env: java
    buildCommand: ./mvnw clean package -DskipTests
    startCommand: java -jar target/encuestas-backend-1.0.0.jar
    envVars:
      - key: SPRING_DATASOURCE_URL
        fromDatabase:
          name: encuestas-db
          property: connectionString
      - key: SPRING_DATASOURCE_USERNAME
        fromDatabase:
          name: encuestas-db
          property: user
      - key: SPRING_DATASOURCE_PASSWORD
        fromDatabase:
          name: encuestas-db
          property: password
      - key: SPRING_JPA_HIBERNATE_DDL_AUTO
        value: update
      - key: JWT_SECRET
        generateValue: true
      - key: CORS_ORIGINS
        value: https://tu-frontend.onrender.com,http://localhost:4200

databases:
  - name: encuestas-db
    databaseName: encuestas_db
    user: encuestas_user