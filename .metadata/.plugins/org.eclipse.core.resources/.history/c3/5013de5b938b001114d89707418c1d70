# Producción / Render
spring.datasource.url=${SPRING_DATASOURCE_URL}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# ============================================
# SEGURIDAD JWT Y CORS
# ============================================
jwt.secret=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
jwt.expiration=86400000

# Permitir localhost en dev o la URL del frontend estático en Render
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:4200}

# Puerto dinámico asignado por Render (fallback a 8080 en local)
server.port=${PORT:8080}