spring.application.name=encuestas-backend

# PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/encuestas_db
spring.datasource.username=postgres
spring.datasource.password=admin
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# JWT
jwt.secret=${JWT_SECRET:inmotion-secret-key-2024-encuestas-app}
jwt.expiration=86400000

# CORS
cors.allowed-origins=${CORS_ORIGINS:http://localhost:4200,https://encuestas-app-rho.vercel.app}

# Server
server.port=8080